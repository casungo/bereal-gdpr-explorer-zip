---
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Page not found | BeReal GDPR Explorer"
  description="This page does not exist. Return to the BeReal archive viewer."
  noindex
>
  <main class="mx-auto max-w-2xl px-5 py-16">
    <h1 class="text-4xl font-bold">Page not found</h1>
    <p class="my-6">This address does not contain a public page.</p>
    <a class="btn btn-primary" href="/">Open the BeReal archive viewer</a>
  </main>
</Layout>
