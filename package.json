{
  "name": "bereal-gdpr-explorer-zip",
  "type": "module",
  "version": "2.1.0",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
    "check": "astro check",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,svelte,astro}\" \"scripts/**/*.mjs\" \"*.{json,js,ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,svelte,astro}\" \"scripts/**/*.mjs\" \"*.{json,js,ts,mjs}\"",
    "test": "vitest run --exclude \"**/*.browser.test.ts\"",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:all": "pnpm test && pnpm test:browser"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/svelte": "^1.27.0",
    "date-fns": "^4.4.0",
    "jszip": "^3.10.1",
    "pako": "^3.0.1",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/svelte": "^9.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitest/browser-playwright": "^4.1.10",
    "astro": "^7.1.3",
    "daisyui": "^5.7.4",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  }
}
